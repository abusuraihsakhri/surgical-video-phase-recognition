{
  "openapi": "3.1.0",
  "info": {
    "title": "Surgical Video Phase Recognition API",
    "description": "Deterministic evaluation API for numeric task payloads. No surgical video or clinical inference.",
    "version": "2.0.1",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Service process responds"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate demonstration rules and record signed audit metadata",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule-evaluation dossier with an in-memory HMAC audit hash"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic supervisory placeholder response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read audit metadata (requires Bearer token from AUDIT_LOGS_TOKEN)",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          },
          "403": {
            "description": "No access token configured or request unauthorized"
          }
        }
      }
    }
  }
}
